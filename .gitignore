# служебное
node_modules/
.DS_Store
.tools/
*.log

# необработанные исходники картинок (в репозиторий идут только webp)
stories/**/assets/raw/

# сборочные кэши исходников новелл
__pycache__/

# временные файлы тестов
tests/.tmp/

# новеллы не хранятся в репозитории: их импортируют из файла .vnmy (npm run pack)
stories/*/
*.vnmy
